<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fr.monolith</groupId>
        <artifactId>hexagonal-monolith</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>infra-web</artifactId>
    <name>infra-web</name>
    <description>
        Adaptateur entrant REST (port HTTP).
        Contient : controllers REST, DTOs request/response, mappers HTTP.
        Pour ajouter GraphQL → créer infra-graphql.
        Pour gRPC → créer infra-grpc.
    </description>

    <dependencies>

        <!-- Application (pour appeler les use cases via ports inbound) -->
        <dependency>
            <groupId>fr.monolith</groupId>
            <artifactId>application</artifactId>
        </dependency>

        <!-- Spring Web MVC (Boot 4 : starter webmvc) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Validation des DTOs -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- OpenAPI / Swagger UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- MapStruct pour les mappers HTTP -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- Tests MockMvc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
